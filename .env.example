# Supabase (required for push notification sync + media submissions)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Expo push tokens (required for physical device push)
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# --- Supabase Edge Function secrets (set via `supabase secrets set`, NOT in the mobile app) ---
# RESEND_API_KEY=your_resend_api_key
# MEDIA_SUGGESTION_NOTIFICATION_EMAIL=owner@example.com
# MEDIA_SUGGESTION_FROM_EMAIL=FCS Pulse <notifications@yourdomain.com>
# MEDIA_ADMIN_SITE_URL=https://admin.fcspulse.com
# (legacy token review secret — no longer used by owner emails:)
# MEDIA_SUGGESTION_REVIEW_SECRET=long-random-secret-for-hmac-review-links
# (legacy alias still used by other media functions:)
# RESEND_FROM_EMAIL=FCS Pulse <notifications@yourdomain.com>
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- Media Admin site (admin-site/ Cloudflare Pages) ---
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key
