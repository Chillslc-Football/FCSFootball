{
  "name": "fcsfootball",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:news-parsers": "npx --yes tsx --tsconfig tsconfig.json src/data/news/runNewsParserTests.ts",
    "test:espn-broadcast": "npx --yes tsx --tsconfig tsconfig.json src/data/providers/runEspnBroadcastTests.ts",
    "test:espn-game-status": "npx --yes tsx --tsconfig tsconfig.json src/data/providers/runEspnGameStatusTests.ts",
    "test:espn-schedule-week": "npx --yes tsx --tsconfig tsconfig.json src/data/providers/runEspnScheduleWeekTests.ts",
    "test:scores-request-guard": "npx --yes tsx --tsconfig tsconfig.json src/data/scores/runScoresRequestGuardTests.ts",
    "test:scores-refresh-scope": "npx --yes tsx --tsconfig tsconfig.json src/data/scores/runScoresRefreshScopeTests.ts",
    "test:live-game-simulation": "npx --yes tsx --tsconfig tsconfig.json src/data/scores/runLiveGameSimulationTests.ts",
    "test:season-week-load": "npx --yes tsx --tsconfig tsconfig.json src/data/teams/runSeasonWeekLoadTests.ts",
    "test:team-season-load": "npx --yes tsx --tsconfig tsconfig.json src/data/teams/runTeamSeasonLoadTests.ts",
    "test:format-game-time": "npx --yes tsx --tsconfig tsconfig.json src/utils/runFormatGameTimeTests.ts",
    "test:team-display": "npx --yes tsx --tsconfig tsconfig.json src/utils/runTeamDisplayTests.ts",
    "test:welcome-storage": "npx --yes tsx --tsconfig tsconfig.json src/data/onboarding/runWelcomeStorageTests.ts",
    "test:app-release-policy": "npx --yes tsx --tsconfig tsconfig.json src/data/release/runAppReleasePolicyTests.ts",
    "test:app-announcement": "npx --yes tsx --tsconfig tsconfig.json src/data/announcement/runAppAnnouncementTests.ts",
    "test:espn-roster": "npx --yes tsx --tsconfig tsconfig.json src/data/providers/runEspnRosterTests.ts",
    "test:espn-fetch-retry": "npx --yes tsx --tsconfig tsconfig.json src/data/providers/runEspnFetchRetryTests.ts",
    "test:media-submissions": "npx --yes tsx --tsconfig tsconfig.json src/data/media/runMediaValidationTests.ts",
    "test:media-directory": "npx --yes tsx --tsconfig tsconfig.json src/data/mediaDirectory/runMediaDirectoryTests.ts",
    "test:media-admin": "npx --yes tsx --tsconfig tsconfig.json src/data/mediaDirectory/runMediaAdminTests.ts",
    "test:notification-init": "npx --yes tsx --tsconfig tsconfig.json src/data/notifications/runNotificationInitTests.ts",
    "test:notification-setup": "npx --yes tsx --tsconfig tsconfig.json src/data/notifications/runNotificationSetupTests.ts",
    "test:responsive-layout": "npx --yes tsx --tsconfig tsconfig.json src/theme/runResponsiveLayoutTests.ts",
    "generate:brand": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "~54.0.36",
    "expo-application": "~7.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "sharp": "^0.35.3",
    "typescript": "~5.9.2"
  },
  "private": true
}
